{
  "name": "shifupo-reels",
  "version": "1.0.0",
  "description": "Shifu Po (Feng Shui & BaZi consultant) promotional Instagram Reels in 2D, built with Remotion",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "studio": "remotion studio",
    "tts": "tsx scripts/tts.ts",
    "vo-level": "tsx scripts/vo-level.ts",
    "sfx": "tsx scripts/sfx.ts",
    "render": "tsx scripts/render.ts",
    "postprocess": "tsx scripts/postprocess.ts",
    "transcribe": "tsx scripts/transcribe.ts",
    "stills": "tsx scripts/stills.ts",
    "produce": "tsx scripts/produce.ts",
    "assets": "tsx scripts/fetch-polyhaven.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests && tsc --noEmit",
    "check": "vitest run && npm run lint"
  },
  "allowScripts": {
    "esbuild": false
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.541",
