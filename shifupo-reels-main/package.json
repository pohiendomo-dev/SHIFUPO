    "@remotion/motion-blur": "4.0.541",
    "@remotion/noise": "4.0.541",
    "@remotion/paths": "4.0.541",
    "@remotion/shapes": "4.0.541",
    "@remotion/three": "4.0.541",
    "@remotion/transitions": "4.0.541",
    "animejs": "4.5.0",
    "mediabunny": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.541",
    "@remotion/install-whisper-cpp": "4.0.541",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/three": "0.187.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
